# Environment Configuration for Bank Finance System
# Copy to .env and fill in your values

# Google AI Configuration (pick one approach)
# Option A: AI Studio (dev) — set GOOGLE_API_KEY
GOOGLE_API_KEY=your-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=False

# Option B: Vertex AI (prod) — set project + location
# GOOGLE_CLOUD_PROJECT=your-project
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True

# Agent A2A Server Ports
ORCHESTRATOR_PORT=8000
ACCOUNT_AGENT_PORT=8001
TRANSACTION_AGENT_PORT=8002
LOAN_AGENT_PORT=8003
CARD_AGENT_PORT=8004
FRAUD_AGENT_PORT=8005
KYC_AGENT_PORT=8006
INVESTMENT_AGENT_PORT=8007
INSURANCE_AGENT_PORT=8008
SUPPORT_AGENT_PORT=8009
AUDIT_AGENT_PORT=8010

# MCP Server Ports (stdio-based, ports for reference only)
MCP_ACCOUNT_PORT=9001
MCP_TRANSACTION_PORT=9002
MCP_LOAN_PORT=9003
MCP_CARD_PORT=9004
MCP_FRAUD_PORT=9005
MCP_KYC_PORT=9006
MCP_MARKET_PORT=9007
MCP_INSURANCE_PORT=9008
MCP_SUPPORT_PORT=9009
MCP_AUDIT_PORT=9010
